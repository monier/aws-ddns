# Environment variables required by this repository.
# Run `make init-env` to create or sync .env from this file.
# Never commit .env — it is git-ignored.

# ── aws-ddns — required ───────────────────────────────────────────────────────
# Credentials of the dedicated IAM user, restricted per apps/aws-ddns/iam-policy.json.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Route 53 hosted zone id that holds the record (e.g. Z0123456789ABCDEFGHIJ).
HOSTED_ZONE_ID=
# Fully-qualified DNS record to keep in sync (e.g. home.example.com).
RECORD_NAME=

# ── aws-ddns — optional (defaults applied when empty) ─────────────────────────
AWS_REGION=us-east-1
# Check interval, Go duration syntax (e.g. 5m, 90s, 1h).
INTERVAL=5m
# DNS record TTL in seconds.
TTL=60
# verbose | debug | info | warning | error
LOG_LEVEL=info
# App data folder — must be readable and writable by the app. Holds the
# last-known-IP state file and an optional aws-ddns.ini. Leave empty for the
# default /var/lib/aws-ddns (a volume in Compose; adjust the compose mount if
# you override this).
DATA_DIR=
